    {
      "id": "dish_recipetin_chinese_fried_rice",
      "name": "Classic Chinese Fried Rice",
      "category": "Dinner",
      "cuisine": "Cantonese",
      "servings": 4,
      "prepTimeMinutes": 15,
      "imageEmoji": "🍚",
      "imageUrl": "https://www.recipetineats.com/wp-content/uploads/2018/03/Fried-Rice_0.jpg",
      "tags": ["Cantonese", "Rice", "Family Favorite", "One Pan"],
      "instructions": "1. Heat oil in a wok or large skillet over high heat. Scramble the eggs quickly, then remove and set aside.\n2. Add a little more oil to the wok, then sauté diced onion, minced garlic, and diced bacon until the bacon is slightly crispy.\n3. Add cold, day-old cooked rice and frozen peas. Toss vigorously to break up the rice clumps.\n4. Pour in soy sauce, oyster sauce, and sesame oil. Toss continuously for 2-3 minutes until the rice is heated through and evenly coated.\n5. Stir the cooked eggs and chopped green onions back into the rice. Serve hot.",
