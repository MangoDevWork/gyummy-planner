    {
      "id": "dish_recipetin_thai_green_curry",
      "name": "Easy Thai Green Curry",
      "category": "Dinner",
      "cuisine": "Thai",
      "servings": 4,
      "prepTimeMinutes": 20,
      "imageEmoji": "🍛",
      "imageUrl": "https://www.recipetineats.com/wp-content/uploads/2019/02/Thai-Green-Curry_5.jpg",
      "tags": ["Thai", "Curry", "One Pot", "Spicy"],
      "instructions": "1. Heat oil in a large pot or wok over medium-high heat. Add the green curry paste and sauté for 2 minutes until very fragrant.\n2. Pour in the coconut milk and chicken broth. Stir well and bring to a gentle simmer.\n3. Add thinly sliced chicken breast and simmer for 5 minutes until the chicken is mostly cooked.\n4. Stir in sliced bamboo shoots, fish sauce, and sugar. Simmer for 2 more minutes.\n5. Turn off the heat. Stir in fresh Thai basil leaves and a squeeze of lime juice.\n6. Serve ladled over jasmine rice.",
